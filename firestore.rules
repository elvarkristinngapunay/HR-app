rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public share endpoints — token is an opaque event id / assignment id
    // only whoever holds the link knows. Read + write allowed to anyone.
    match /event_rsvps/{eventId}/guests/{guestId} {
      allow read, write: if true;
    }
    match /training_shares/{assignmentId} {
      allow read, write: if true;
    }
  }
}
